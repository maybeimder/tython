{
      "compilerOptions": {
            "rootDir": "./src",
            "outDir": "./dist",

            "module": "nodenext",
            "moduleResolution": "nodenext",
            "target": "esnext",
            "types": [],

            "sourceMap": true,

            "strict": true,
            "esModuleInterop": true,
            "skipDefaultLibCheck": true,
            "allowImportingTsExtensions": true,
            "rewriteRelativeImportExtensions": true, // <-- AGREGA ESTA LÍNEA
      },
      "include": ["src"],
}
